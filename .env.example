# Required API keys
OPENAI_API_KEY=sk-your-openai-key
YOUTUBE_API_KEY=your-youtube-data-api-key
PINECONE_API_KEY=pcsk-your-pinecone-key

# Seeded Agent Card discovery URLs used by the orchestrator
YOUTUBE_AGENT_CARD_URL=http://localhost:5001/.well-known/agent-card.json
PRODUCT_AGENT_CARD_URL=http://localhost:5002/.well-known/agent-card.json

# Optional tuning
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
PINECONE_INDEX_NAME=fmas-youtube-transcripts
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
ENABLE_PINECONE=true
ENABLE_LEGACY_SHOPPING_FLOW=true
ENABLE_MOCK_PRODUCT_CATALOG=true
A2A_CLIENT_TIMEOUT_SECONDS=30
YOUTUBE_REVIEW_CONCURRENCY=3
YOUTUBE_TRANSCRIPT_CHUNK_SIZE=900
YOUTUBE_TRANSCRIPT_CHUNK_OVERLAP=120
LOG_LEVEL=INFO
